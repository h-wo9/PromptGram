# Database
DATABASE_URL=postgresql+asyncpg://promptgram:promptgram@localhost:55432/promptgram

# JWT — 무료 cross-domain 호스팅 트레이드오프: refresh는 localStorage + rotation,
# access는 짧게(30분). 커스텀 도메인 시 httpOnly cookie로 전환 가능.
JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS (comma-separated FE origins; cookie 미사용이므로 credentials 불필요)
CORS_ORIGINS=http://localhost:5173

# AI — Gemini 단일 provider. key 없으면 /ai/* 실행 불가 (구조는 동작).
# 무료 티어: 입력·출력이 학습에 쓰일 수 있음 — 민감정보 금지. billing 켜면 무료 티어 소멸 주의.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Redis — AI rate limit·응답 캐시 저장소 (재시작·멀티 워커에서도 유지).
# 미설정 시 in-memory fallback (로컬/테스트용). docker compose 사용 시 아래 값.
REDIS_URL=redis://localhost:56379/0
