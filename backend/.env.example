# Database
DATABASE_URL=postgresql+asyncpg://promptgram:promptgram@localhost:55432/promptgram

# JWT — 무료 cross-domain 호스팅 트레이드오프: refresh는 localStorage + rotation,
# access는 짧게(30분). 커스텀 도메인 시 httpOnly cookie로 전환 가능.
JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS (comma-separated FE origins; cookie 미사용이므로 credentials 불필요)
CORS_ORIGINS=http://localhost:5173

# AI (Phase 2)
LLM_PROVIDER=ollama
GEMINI_API_KEY=
